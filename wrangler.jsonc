{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pomodoro-ledger",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    {
      "pattern": "pomodoro.jbndr.com",
      "custom_domain": true
    }
  ],
  // Astro builds the site into ./dist and Vite the app into ./dist/app; /api/* and / (old invite links) reach the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/api/*"]
  },
  // Cloudflare Access app protecting /api/sync. See README → Sync between devices.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "jbndr.cloudflareaccess.com",
    "ACCESS_AUD": "275da6a82d30e72e003e3052c1b1306fe9d0fcf8ca4bdfbb29a455efd7503c69"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LEDGER", "class_name": "Ledger" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "COUNTS", "class_name": "Counts" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Ledger"] },
    { "tag": "v3", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v4", "new_sqlite_classes": ["Counts"] }
  ]
}
