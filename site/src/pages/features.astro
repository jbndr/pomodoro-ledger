---
import Base from "../layouts/Base.astro";
import { AREAS } from "../data/features";
---
<Base title="Features" description="Everything Pomodoro Ledger does today.">
  <div class="wrap">
    <header class="page-head">
      <h1>Everything it does.</h1>
      <p>All of it works in the browser today — no account, no install.</p>
    </header>
    <nav class="jump" aria-label="Areas">{AREAS.map((a) => <a href={`#${a.key}`}>{a.title}</a>)}</nav>
    {AREAS.map((a) => (
      <section class="area" id={a.key}>
        <div class="side">
          <h2>{a.title}</h2>
          <p class="muted">{a.lede}</p>
        </div>
        <div class="grid">
          {a.shipped.map((f) => (
            <article class="card"><h3>{f.title}</h3><p>{f.blurb}</p></article>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .jump a { text-decoration: none; font-size: 14px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); }
  .area { display: grid; grid-template-columns: 15rem 1fr; gap: 32px; padding: 48px 0; border-top: 1px solid var(--line); scroll-margin-top: 72px; }
  .side h2 { font-size: 26px; }
  .side p { font-size: 15px; margin: 10px 0 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 12px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 18px; }
  .card h3 { font-size: 17px; margin: 0 0 6px; }
  .card p { margin: 0; font-size: 14.5px; color: var(--muted); }
  @media (max-width: 760px) { .area { grid-template-columns: 1fr; gap: 18px; } }
</style>
