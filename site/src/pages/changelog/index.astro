---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { day } from "../../lib";
const entries = (await getCollection("changelog")).sort((a, b) => b.data.n - a.data.n);
const days = new Map<string, typeof entries>();
for (const e of entries) {
  const k = e.data.date.toISOString().slice(0, 10);
  days.set(k, [...(days.get(k) ?? []), e]);
}
const rendered = new Map(await Promise.all(entries.map(async (e) => [e.id, (await render(e)).Content] as const)));
---
<Base title="Changelog" description="Every change to Pomodoro Ledger, newest first.">
  <div class="col">
    <header class="page-head">
      <h1>Every change, as it ships.</h1>
      <p>{entries.length} releases so far. Follow along with <a href="/changelog/rss.xml">RSS</a>.</p>
    </header>
    {[...days].map(([k, list]) => (
      <section class="day">
        <h2><time datetime={k}>{day(list[0].data.date)}</time></h2>
        <ol>
          {list.map((e) => {
            const Body = rendered.get(e.id)!;
            return <li id={String(e.data.n)}><h3>{e.data.title}</h3><div class="md"><Body /></div></li>;
          })}
        </ol>
      </section>
    ))}
  </div>
</Base>
<style>
  .day { display: grid; grid-template-columns: 12rem 1fr; gap: 32px; padding: 32px 0; border-top: 1px solid var(--line); }
  .day h2 { font: 500 14.5px/1.5 var(--f-body); color: var(--faint); position: sticky; top: 80px; align-self: start; letter-spacing: 0; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  li { scroll-margin-top: 80px; }
  li:target h3 { color: var(--tomato); }
  h3 { font: 550 17px/1.4 var(--f-body); letter-spacing: -.005em; }
  .md :global(p) { margin: 4px 0 0; font-size: 15px; color: var(--muted); }
  @media (max-width: 680px) { .day { grid-template-columns: 1fr; gap: 12px; } .day h2 { position: static; } }
</style>
