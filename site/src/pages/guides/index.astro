---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { posts } from "../../lib";
const list = await posts("guides");
---
<Base title="Guides" description="Practical guides to the Pomodoro technique, planning and deep work." noindex={!list.length}>
  <div class="col">
    <header class="page-head">
      <h1>Getting more out of focus.</h1>
      <p>Practical guides to the Pomodoro technique, planning and deep work.</p>
    </header>
    <PostList posts={list} base="/guides" empty="First post coming soon." />
  </div>
</Base>
