---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { SITE } from "../lib";
import todayL from "../assets/shots/today-light.png";
import todayD from "../assets/shots/today-dark.png";
import recapL from "../assets/shots/recap-light.png";
import recapD from "../assets/shots/recap-dark.png";
import progL from "../assets/shots/progress-light.png";
import progD from "../assets/shots/progress-dark.png";

const latest = (await getCollection("changelog")).sort((a, b) => b.data.n - a.data.n).slice(0, 6);
const total = (await getCollection("changelog")).length;
const short = (d: Date) => d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", timeZone: "UTC" });

const entries = [
  ["09:02", "Plan the day", "Planning", 1, "25m"],
  ["09:30", "Write the onboarding guide", "Writing", 3, "1h 15m"],
  ["11:10", "Prepare the investor update", "Admin", 2, "50m"],
  ["14:00", "Review pull requests", "App", 2, "52m"],
  ["15:05", "Flow: landing page copy", "Website", 0, "1h 12m"],
] as const;
---
<Base returning>
  <section class="hero wrap">
    <h1>Focus,<br /><span>written down.</span></h1>
    <div class="intro">
      <p>A Pomodoro timer that keeps a ledger. Estimate tasks in rounds, work through them, and see exactly where the hours went.</p>
      <div class="cta">
        <a class="btn primary big" href={SITE.app}>Start focusing</a>
        <a class="link" href="/app/?demo=1">or try it with sample data →</a>
      </div>
      <p class="fine">Free. Runs in your browser. No account.</p>
    </div>
  </section>

  <div class="stage">
    <div class="wrap"><Shot light={todayL} dark={todayD} width={1200} eager alt="The Pomodoro Ledger timer running a focus round next to today's tasks" /></div>
  </div>

  <section class="wrap book">
    <div class="book-copy">
      <h2>Every round is an entry.</h2>
      <p>Give each task a few rounds — press <kbd>N</kbd> and type <code>Draft the brief 3 #writing</code>. Every session is then written against that task and its label: rounds, minutes, overtime. At the end of the day the column adds up.</p>
    </div>
    <div class="ledger" role="table" aria-label="A sample day in the ledger">
      {entries.map(([t, task, label, rounds, dur], i) => (
        <div class="row" role="row" style={`--i:${i}`}>
          <span class="t" role="cell">{t}</span>
          <span class="task" role="cell">{task}<em>{label}</em></span>
          <span class="r" role="cell" aria-label={rounds ? `${rounds} rounds` : "flow"}>{rounds ? "●".repeat(rounds) : "flow"}</span>
          <span class="d" role="cell">{dur}</span>
        </div>
      ))}
      <div class="row sum" role="row"><span class="t" role="cell"></span><span class="task" role="cell">Today</span><span class="r" role="cell">8</span><span class="d" role="cell">4h 34m</span></div>
    </div>
  </section>

  <section class="wrap chapter">
    <div class="copy">
      <span class="num">01</span>
      <h2>Close the week properly.</h2>
      <p>Every Monday a short recap: total focus, your best day, top labels and what you finished. Then plan the next one — leftovers, a few objectives, done.</p>
    </div>
    <Shot light={recapL} dark={recapD} width={560} class="narrow" alt="The weekly recap: focus total, best day, top labels and finished tasks" />
  </section>

  <section class="wrap chapter flip">
    <div class="copy">
      <span class="num">02</span>
      <h2>Watch the year add up.</h2>
      <p>Focus per day, by label, at your best time of day. A weekly recap every Monday, and a Year in Focus story when you want the long view. All of it from the same honest record.</p>
    </div>
    <Shot light={progL} dark={progD} width={900} alt="Progress: the year so far, hours per label and daily focus" />
  </section>

  <section class="wrap tenets">
    <h2 class="sr">How it's built</h2>
    <dl>
      <div><dt>No account needed.</dt><dd>Your ledger lives in your browser. Export it any time; sync between devices only if you want to.</dd></div>
      <div><dt>Rooms, not feeds.</dt><dd>Focus alongside other people in a room. They see you're there — never what you're working on.</dd></div>
      <div><dt>Quiet by design.</dt><dd>Soundscapes made in the browser, one nudge per break, and a site blocker that only works while you do.</dd></div>
    </dl>
  </section>

  <section class="wrap log">
    <div class="log-head">
      <h2>Built in the open.</h2>
      <p>{total} releases so far. <a href="/changelog">Read the changelog</a> or <a href="/devlog">the devlog</a>.</p>
    </div>
    <ol>
      {latest.map((e) => (
        <li><time datetime={e.data.date.toISOString()}>{short(e.data.date)}</time><a href={`/changelog#${e.data.n}`}>{e.data.title}</a><span>#{e.data.n}</span></li>
      ))}
    </ol>
  </section>

  <section class="wrap close">
    <h2>Your next 25 minutes<br />start here.</h2>
    <a class="btn primary big" href={SITE.app}>Start focusing</a>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: end; padding-top: clamp(56px, 10vw, 128px); padding-bottom: 56px; }
  h1 { font-size: clamp(56px, 10.5vw, 136px); line-height: .9; letter-spacing: -.045em; font-weight: 700; }
  h1 span { color: var(--tomato); }
  .intro > p:first-child { font-size: 20px; line-height: 1.5; margin: 0 0 28px; }
  .cta { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .btn.big { height: 48px; padding: 0 22px; font-size: 16px; }
  .link { color: var(--muted); text-decoration: none; font-size: 15px; }
  .link:hover { color: var(--fg); }
  .fine { margin: 20px 0 0; font-size: 14px; color: var(--faint); }

  .stage { position: relative; padding-bottom: 24px; }
  .stage::before { content: ""; position: absolute; inset: 10% 0 0; background: radial-gradient(60% 70% at 50% 30%, color-mix(in oklab, var(--tomato) 16%, transparent), transparent 70%); z-index: -1; }

  h2 { font-size: clamp(32px, 4.4vw, 52px); letter-spacing: -.035em; }
  .book { display: grid; grid-template-columns: 1fr 1.25fr; gap: 64px; align-items: center; padding-top: 140px; }
  .book-copy p, .chapter p { font-size: 18px; color: var(--muted); margin: 20px 0 0; max-width: 30rem; }

  .ledger { font-variant-numeric: tabular-nums; background: var(--surface); border-radius: 4px 4px 18px 18px; padding: 8px 28px 20px; border: 1px solid var(--line);
    background-image: linear-gradient(90deg, transparent 4.2rem, color-mix(in oklab, var(--tomato) 35%, transparent) 4.2rem, color-mix(in oklab, var(--tomato) 35%, transparent) calc(4.2rem + 1px), transparent calc(4.2rem + 1px)); }
  .row { display: grid; grid-template-columns: 3.4rem 1fr auto 4.6rem; gap: 18px; align-items: baseline; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .t { color: var(--faint); font-size: 14px; }
  .task { font-weight: 500; }
  .task em { font-style: normal; color: var(--faint); font-size: 13.5px; margin-left: 10px; }
  .r { color: var(--tomato); letter-spacing: 2px; font-size: 11px; }
  .d { text-align: right; }
  .sum { border-bottom: 0; font-weight: 650; }
  .sum .r { color: var(--fg); font-size: 15px; letter-spacing: 0; }
  .sum .d, .sum .r { text-decoration: underline double; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ledger .row { animation: write linear both; animation-timeline: view(); animation-range: entry calc(10% + var(--i, 5) * 6%) entry calc(40% + var(--i, 5) * 6%); }
      @keyframes write { from { opacity: 0; transform: translateY(6px); } }
    }
  }

  .chapter { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: center; padding-top: 160px; }
  .chapter.flip { grid-template-columns: 1.6fr 1fr; }
  .chapter.flip .copy { order: 2; }
  .chapter :global(.narrow) { max-width: 460px; justify-self: center; }
  .num { display: block; font: 600 15px/1 var(--f-display); color: var(--tomato); margin-bottom: 18px; font-variant-numeric: tabular-nums; }
  kbd, code { font: 14px var(--f-mono); background: var(--surface-2); border: 1px solid var(--line); padding: 1px 6px; border-radius: 6px; color: var(--fg); }

  .tenets { padding-top: 160px; }
  .tenets dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; border-top: 2px solid var(--fg); }
  .tenets div { padding: 28px 28px 0 0; }
  .tenets div + div { padding-left: 28px; border-left: 1px solid var(--line); }
  .tenets dt { font: 650 24px/1.15 var(--f-display); letter-spacing: -.02em; }
  .tenets dd { margin: 12px 0 0; color: var(--muted); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .log { padding-top: 160px; display: grid; grid-template-columns: 1fr 1.5fr; gap: 64px; }
  .log-head p { color: var(--muted); font-size: 17px; margin: 16px 0 0; }
  .log ol { list-style: none; margin: 0; padding: 0; font-variant-numeric: tabular-nums; }
  .log li { display: grid; grid-template-columns: 4.2rem 1fr auto; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .log li:first-child { border-top: 1px solid var(--line); }
  .log time, .log li span { color: var(--faint); font-size: 14px; }
  .log li a { text-decoration: none; }
  .log li a:hover { color: var(--tomato); }

  .close { padding-top: 180px; text-align: center; }
  .close h2 { font-size: clamp(40px, 6.4vw, 84px); margin-bottom: 36px; }

  @media (max-width: 860px) {
    .hero, .book, .chapter, .chapter.flip, .log { grid-template-columns: 1fr; gap: 32px; }
    .chapter.flip .copy { order: 0; }
    .book, .chapter, .tenets, .log { padding-top: 96px; }
    .tenets dl { grid-template-columns: 1fr; }
    .tenets div, .tenets div + div { padding: 24px 0; border-left: 0; border-bottom: 1px solid var(--line); }
    .close { padding-top: 120px; }
  }
  @media (max-width: 520px) {
    .ledger { padding: 4px 16px 14px; background-image: none; }
    .row { grid-template-columns: 2.9rem 1fr 3.8rem; gap: 10px; }
    .r { display: none; }
    .task em { display: block; margin: 2px 0 0; }
  }
</style>
