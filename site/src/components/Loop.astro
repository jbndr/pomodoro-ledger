---
const steps = [
  { c: "var(--leaf)", title: "Plan", text: "Give tasks a few rounds. Today tells you when you'll be done.", href: "#planning" },
  { c: "var(--tomato)", title: "Focus", text: "Alone or in a room, with a floating timer and a nudge each break.", href: "#timer" },
  { c: "var(--sky)", title: "Write it down", text: "Every round lands next to what you planned. You log nothing.", href: "#ledger" },
  { c: "var(--violet)", title: "Learn", text: "See which tasks you underestimate and when you focus best.", href: "#ledger" },
];
---
<div class="loop">
  <ol>
    {steps.map((s, i) => (
      <li style={`--c:${s.c}`}>
        <a href={s.href}>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <b>{s.title}</b>
          <span class="t">{s.text}</span>
        </a>
      </li>
    ))}
  </ol>
  <div class="back" aria-hidden="true"><span>and the next plan starts a little more honest</span></div>
</div>
<style>
  .loop { margin-top: 34px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; position: relative; }
  li { position: relative; }
  li + li::before { content: ""; position: absolute; left: -14px; top: 34px; width: 14px; height: 1.5px; background: var(--line-2); }
  li + li::after { content: ""; position: absolute; left: -6px; top: 31px; width: 6px; height: 6px; border-top: 1.5px solid var(--line-2); border-right: 1.5px solid var(--line-2); rotate: 45deg; }
  a { display: grid; gap: 6px; height: 100%; padding: 16px 16px 18px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); text-decoration: none; transition: border-color .2s, translate .25s cubic-bezier(.2, .9, .25, 1), box-shadow .25s; }
  a:hover { border-color: color-mix(in oklab, var(--c) 45%, var(--line)); translate: 0 -2px; box-shadow: 0 12px 24px -16px color-mix(in oklab, var(--c) 60%, transparent); }
  .n { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 7px; font: 650 12px/1 var(--f-body); color: var(--c); background: color-mix(in oklab, var(--c) 14%, transparent); margin-bottom: 4px; }
  b { font: 650 16px/1.2 var(--f-display); letter-spacing: -.01em; }
  .t { font-size: 14px; line-height: 1.5; color: var(--muted); }
  .back { position: relative; height: 34px; margin: 0 12.5%; border: 1.5px solid var(--line-2); border-top: 0; border-radius: 0 0 18px 18px; }
  .back::before { content: ""; position: absolute; left: -5.5px; top: -2px; width: 8px; height: 8px; border-top: 1.5px solid var(--line-2); border-left: 1.5px solid var(--line-2); rotate: 45deg; }
  .back span { position: absolute; left: 50%; bottom: 0; translate: -50% 50%; padding: 0 12px; background: var(--bg); font-size: 13px; color: var(--faint); white-space: nowrap; }
  @media (max-width: 720px) {
    ol { grid-template-columns: 1fr; gap: 12px; }
    li + li::before { left: 26px; top: -12px; width: 1.5px; height: 12px; }
    li + li::after { left: 23px; top: -7px; rotate: 135deg; }
    .back { margin: 0 0 0 26px; height: auto; border: 0; padding: 14px 0 0; }
    .back::before { display: none; }
    .back span { position: static; translate: none; padding: 0; white-space: normal; }
    .back span::before { content: "↺  "; }
  }
</style>
