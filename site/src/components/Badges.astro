---
import { emblem, shapeMask } from "../../../web/src/year/emblems";
import type { BadgeId } from "../../../web/src/lib/year";

const LIST: { id: BadgeId; name: string; how: string; have: number; need: number }[] = [
  { id: "century", name: "Century", how: "Finish 100 cycles in a year", have: 100, need: 100 },
  { id: "week", name: "Week streak", how: "Focus 7 days in a row", have: 7, need: 7 },
  { id: "marathon", name: "Marathon day", how: "Finish 10 cycles in one day", have: 10, need: 10 },
  { id: "early", name: "Early bird", how: "Start 10 cycles before 8 am", have: 10, need: 10 },
  { id: "owl", name: "Night owl", how: "Start 10 cycles after 9 pm", have: 3, need: 10 },
  { id: "weekend", name: "Weekend warrior", how: "Focus on 10 weekend days", have: 6, need: 10 },
  { id: "loyal", name: "Label loyalist", how: "Finish 50 cycles under one label", have: 50, need: 50 },
  { id: "goal", name: "Goal getter", how: "Reach your daily goal on 10 days", have: 10, need: 10 },
  { id: "comeback", name: "Comeback", how: "Return after two weeks away", have: 0, need: 14 },
  { id: "allYear", name: "All year round", how: "Focus in every month", have: 10, need: 12 },
  { id: "month", name: "Month streak", how: "Focus 30 days in a row", have: 17, need: 30 },
  { id: "finisher", name: "Finisher", how: "Finish 25 tasks", have: 25, need: 25 },
];
const items = LIST.map((b, i) => {
  const earned = b.have >= b.need;
  return { ...b, earned, i, svg: emblem(b.id, { locked: !earned }), mask: earned ? shapeMask(b.id) : "" };
});
const total = items.filter((b) => b.earned).length;
---
<div class="badges" data-badges>
  <ul>
    {items.map((b) => (
      <li>
        <button type="button" class:list={["badge", { locked: !b.earned }]} data-how={`${b.name}: ${b.how}${b.earned ? "" : ` (${b.have} of ${b.need})`}`} aria-label={`${b.name}. ${b.how}. ${b.earned ? "Earned" : `${b.have} of ${b.need}`}`}>
          <span class:list={["medal", { locked: !b.earned }]} style={`${b.mask ? `--mask:${b.mask};` : ""}--d:${b.i}`}>
            <Fragment set:html={b.svg} />
            {b.earned && <i class="foil" />}
            {b.earned && <i class="glare" />}
          </span>
          <b>{b.name}</b>
          {!b.earned && b.have > 0 && <small><span style={`--p:${(b.have / b.need) * 100}%`}></span>{b.have} of {b.need}</small>}
        </button>
      </li>
    ))}
  </ul>
  <p class="how" aria-live="polite" data-default={`${total} of ${items.length} this year. Point at one to see how it's earned.`}>{total} of {items.length} this year. Point at one to see how it's earned.</p>
</div>
<style>
  .badges { width: min(640px, 100%); padding: 22px 18px 16px; border-radius: 22px; background: color-mix(in oklab, var(--surface) 82%, transparent); backdrop-filter: blur(14px) saturate(1.3); -webkit-backdrop-filter: blur(14px) saturate(1.3); box-shadow: 0 0 0 1px rgb(20 24 22 / .06), 0 26px 50px -26px rgb(20 24 22 / .4); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px 6px; }
  .badge { appearance: none; width: 100%; display: grid; justify-items: center; align-content: start; gap: 6px; padding: 6px 2px; border: 0; border-radius: 14px; background: transparent; color: var(--fg); cursor: default; font: inherit; -webkit-tap-highlight-color: transparent; transition: background .2s; }
  .badge:hover, .badge:focus-visible { background: color-mix(in oklab, var(--fg) 6%, transparent); }
  .badge b { font: 600 12.5px/1.2 var(--f-body); text-align: center; }
  .badge.locked b { color: var(--muted); font-weight: 550; }
  .badge small { display: grid; gap: 4px; justify-items: center; font: 500 11px/1 var(--f-body); color: var(--faint); font-variant-numeric: tabular-nums; }
  .badge small span { width: 36px; height: 3px; border-radius: 3px; background: color-mix(in oklab, var(--fg) 12%, transparent); overflow: hidden; position: relative; }
  .badge small span::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--p); background: var(--muted); border-radius: inherit; }
  .medal { position: relative; display: block; width: 62px; aspect-ratio: 1; transition: transform .7s cubic-bezier(.22, 1, .36, 1); color: var(--muted); }
  .medal.on { transform: perspective(420px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(1.04); transition: transform .12s linear; }
  .medal :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  .medal:not(.locked) :global(svg) { filter: drop-shadow(0 5px 8px rgb(0 0 0 / .22)); }
  .foil, .glare { position: absolute; inset: 0; pointer-events: none; -webkit-mask: var(--mask) center / 100% 100% no-repeat; mask: var(--mask) center / 100% 100% no-repeat; }
  .foil {
    background:
      radial-gradient(circle, rgb(255 255 255 / .9) 0 .5px, transparent 1px) 0 0 / 4px 4px,
      repeating-linear-gradient(122deg, #e0303a 0%, #f2a020 3.5%, #c8d81c 7%, #18c87a 10.5%, #1aa6e8 14%, #6a4cf0 17.5%, #d43ab8 21%, #e0303a 24.5%) var(--px, 32%) var(--py, 28%) / 260% 260%;
    mix-blend-mode: color-dodge; opacity: .16; filter: brightness(.62) contrast(1.6) saturate(1.5);
    transition: opacity .4s, background-position .7s cubic-bezier(.22, 1, .36, 1);
  }
  .go .foil { animation: sweep 1.6s cubic-bezier(.22, 1, .36, 1) backwards; animation-delay: calc(200ms + var(--d, 0) * 70ms); }
  .glare { background: radial-gradient(circle at var(--gx, 30%) var(--gy, 18%), rgb(255 255 255 / .55), rgb(255 255 255 / 0) 44%); mix-blend-mode: soft-light; opacity: .6; transition: opacity .4s; }
  .medal.on .foil { opacity: .66; transition: opacity .2s, background-position .12s linear; }
  .medal.on .glare { opacity: 1; transition: opacity .2s; }
  @keyframes sweep { from { background-position: 0 0, 110% 110%; opacity: .7; } }
  .how { margin: 16px 0 0; text-align: center; font-size: 13px; color: var(--muted); min-height: 1.5em; transition: opacity .2s; }
  @media (max-width: 640px) {
    .badges { padding: 16px 10px 12px; }
    ul { grid-template-columns: repeat(4, 1fr); gap: 12px 2px; }
    .medal { width: 52px; }
    .badge b { font-size: 11.5px; }
  }
  @media (prefers-reduced-motion: reduce) { .medal, .foil { transition: none; animation: none !important; } }
</style>
<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-badges]")) {
    const how = box.querySelector<HTMLElement>(".how")!;
    if (matchMedia("(pointer: coarse)").matches) { how.dataset.default = how.dataset.default!.replace("Point at", "Tap"); how.textContent = how.dataset.default; }
    const calm = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
    let lit: HTMLElement | null = null;
    const say = (t: string) => { if (how.textContent !== t) how.textContent = t; };
    const dim = () => { if (lit) { for (const p of ["--rx", "--ry", "--px", "--py", "--gx", "--gy"]) lit.style.removeProperty(p); lit.classList.remove("on"); lit = null; } };
    const light = (badge: HTMLElement, cx: number, cy: number) => {
      const el = badge.querySelector<HTMLElement>(".medal")!;
      say(badge.dataset.how!);
      if (el.classList.contains("locked") || calm()) return;
      if (lit !== el) dim();
      const r = el.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (cx - r.left) / r.width)), y = Math.max(0, Math.min(1, (cy - r.top) / r.height));
      el.style.setProperty("--rx", ((0.5 - y) * 26).toFixed(2) + "deg");
      el.style.setProperty("--ry", ((x - 0.5) * 26).toFixed(2) + "deg");
      for (const [p, v] of [["--px", x], ["--py", y], ["--gx", x], ["--gy", y]] as const) el.style.setProperty(p, (v * 100).toFixed(1) + "%");
      el.classList.add("on"); lit = el;
    };
    box.addEventListener("pointermove", (e) => {
      const badge = (e.target as HTMLElement).closest<HTMLElement>(".badge");
      if (badge) light(badge, e.clientX, e.clientY); else { dim(); say(how.dataset.default!); }
    });
    box.addEventListener("pointerleave", () => { dim(); say(how.dataset.default!); });
    box.addEventListener("click", (e) => {
      const badge = (e.target as HTMLElement).closest<HTMLElement>(".badge");
      if (!badge) return;
      const r = badge.querySelector(".medal")!.getBoundingClientRect();
      light(badge, r.left + r.width * 0.3, r.top + r.height * 0.25);
    });
    box.addEventListener("focusin", (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>(".badge"); if (b) say(b.dataset.how!); });
    let seen = false;
    const sweep = () => {
      const pane = box.closest(".pane");
      if (!seen || (pane && !pane.hasAttribute("data-on"))) return;
      box.classList.remove("go"); void box.offsetWidth; box.classList.add("go");
    };
    new IntersectionObserver((es) => { const now = es.some((e) => e.isIntersecting); if (now && !seen) { seen = true; sweep(); } else if (!now) seen = false; }, { threshold: 0.4 }).observe(box);
    box.closest(".showcase")?.addEventListener("pane", () => requestAnimationFrame(sweep));
  }
</script>
