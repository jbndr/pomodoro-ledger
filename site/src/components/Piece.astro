---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { light: ImageMetadata; dark: ImageMetadata; alt: string; w: number; crop?: number; eager?: boolean }
const { light, dark, alt, w, crop, eager = false } = Astro.props;
const loading = eager ? "eager" : "lazy";
---
<div class:list={["piece", { crop }]} style={`--w:${w}px;${crop ? `--crop:${crop}px` : ""}`}>
  <Image class="on-light" src={light} alt={alt} width={w} densities={[1, 2]} loading={loading} />
  <Image class="on-dark" src={dark} alt="" aria-hidden="true" width={w} densities={[1, 2]} loading={loading} />
</div>
<style>
  .piece { width: min(var(--w), 100%); position: relative; }
  .piece :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 2px 3px rgb(20 24 22 / .1)) drop-shadow(0 22px 34px rgb(20 24 22 / .22)); }
  .crop { max-height: var(--crop); overflow: hidden; padding: 0 0 2px; -webkit-mask-image: linear-gradient(#000 78%, transparent); mask-image: linear-gradient(#000 78%, transparent); }
  .crop :global(img) { filter: none; }
</style>
