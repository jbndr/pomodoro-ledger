---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { light: ImageMetadata; dark: ImageMetadata; phoneLight?: ImageMetadata; phoneDark?: ImageMetadata; alt: string; w: number; crop?: number; eager?: boolean }
const { light, dark, phoneLight, phoneDark, alt, w, crop, eager = false } = Astro.props;
const phone = phoneLight && phoneDark;
const loading = eager ? "eager" : "lazy";
---
<div class:list={["piece", { crop, split: phone }]} style={`--w:${w}px;${crop ? `--crop:${crop}px` : ""}`}>
  <Image class="on-light wide" src={light} alt={alt} width={w} densities={[1, 2]} loading={loading} />
  <Image class="on-dark wide" src={dark} alt="" aria-hidden="true" width={w} densities={[1, 2]} loading={loading} />
  {phone && <Image class="on-light narrow" src={phoneLight} alt={alt} width={340} densities={[1, 2]} loading="lazy" />}
  {phone && <Image class="on-dark narrow" src={phoneDark} alt="" aria-hidden="true" width={340} densities={[1, 2]} loading="lazy" />}
</div>
<style>
  .piece { width: min(var(--w), 100%); position: relative; }
  .piece :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 2px 3px rgb(20 24 22 / .1)) drop-shadow(0 22px 34px rgb(20 24 22 / .22)); }
  .crop { max-height: var(--crop); overflow: hidden; padding: 0 0 2px; -webkit-mask-image: linear-gradient(#000 78%, transparent); mask-image: linear-gradient(#000 78%, transparent); }
  .crop :global(img) { filter: none; }
  .split :global(img.narrow) { display: none !important; }
  @media (max-width: 640px) {
    .split :global(img.wide) { display: none !important; }
    .split :global(img.narrow.on-light) { display: block !important; }
    .split { max-height: none; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); max-height: 360px; }
  }
  @media (max-width: 640px) and (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .split :global(img.narrow.on-light) { display: none !important; }
    :global(:root:not([data-theme="light"])) .split :global(img.narrow.on-dark) { display: block !important; }
  }
  @media (max-width: 640px) {
    :global(:root[data-theme="dark"]) .split :global(img.narrow.on-light) { display: none !important; }
    :global(:root[data-theme="dark"]) .split :global(img.narrow.on-dark) { display: block !important; }
  }
</style>
