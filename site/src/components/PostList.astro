---
import type { CollectionEntry } from "astro:content";
import { day } from "../lib";
interface Props { posts: CollectionEntry<"devlog" | "guides">[]; base: string; empty: string }
const { posts, base, empty } = Astro.props;
---
{posts.length ? (
  <ol class="posts">
    {posts.map((p) => (
      <li><a href={`${base}/${p.id}`}><time datetime={p.data.date.toISOString()}>{day(p.data.date)}</time><h2>{p.data.title}{p.data.draft && <span class="tag">Draft</span>}</h2><p>{p.data.description}</p></a></li>
    ))}
  </ol>
) : <p class="muted">{empty}</p>}
<style>
  .posts { list-style: none; margin: 0; padding: 0; }
  .posts a { display: block; padding: 24px 0; border-top: 1px solid var(--line); text-decoration: none; }
  .posts time { font-size: 14px; color: var(--faint); }
  .posts h2 { font-size: 24px; margin: 6px 0; display: flex; gap: 10px; align-items: center; }
  .posts p { margin: 0; color: var(--muted); max-width: 40rem; }
  .posts a:hover h2 { color: var(--tomato); }
</style>
