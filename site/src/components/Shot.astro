---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { light: ImageMetadata; dark: ImageMetadata; alt: string; width: number; eager?: boolean; class?: string }
const { light, dark, alt, width, eager = false, class: cls } = Astro.props;
const load = eager ? "eager" : "lazy";
---
<figure class:list={["shot", cls]}>
  <Image class="l" src={light} alt={alt} width={width} densities={[1, 2]} loading={load} />
  <Image class="d" src={dark} alt="" width={width} densities={[1, 2]} loading={load} aria-hidden="true" />
</figure>
<style>
  .shot { margin: 0; border-radius: 22px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); box-shadow: 0 1px 0 rgb(0 0 0 / .03), 0 40px 80px -40px rgb(20 24 22 / .35); }
  .shot :global(img) { display: block; width: 100%; height: auto; }
  .shot :global(.d) { display: none; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .shot :global(.l) { display: none; } :root:not([data-theme="light"]) .shot :global(.d) { display: block; } }
  :root[data-theme="dark"] .shot :global(.l) { display: none; }
  :root[data-theme="dark"] .shot :global(.d) { display: block; }
</style>
