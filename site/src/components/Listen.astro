---
import { PRESETS } from "../../../web/src/lib/mix";
const names: Record<string, string> = { rain: "Rain", ocean: "Ocean", fire: "Fire", brown: "Brown noise" };
const presets = PRESETS.map((p) => ({ ...p, parts: p.mix.split(",").map((x) => names[x.split(":")[0]]) }));
---
<div class="listen" data-listen>
  {presets.map((p) => (
    <button type="button" class="tile" data-mix={p.mix} aria-pressed="false">
      <span class="ic" aria-hidden="true">
        <svg class="play" viewBox="0 0 16 16"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor" /></svg>
        <span class="eq"><i></i><i></i><i></i></span>
      </span>
      <span class="txt"><b>{p.name}</b><small>{p.parts.join(" + ")}</small></span>
    </button>
  ))}
</div>
<style>
  .listen { width: min(520px, 100%); display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .tile { appearance: none; display: flex; align-items: center; gap: 13px; text-align: left; padding: 16px; border-radius: 18px; border: 1px solid rgb(255 255 255 / .22); cursor: pointer;
    background: rgb(255 255 255 / .12); color: #FFF7EE; backdrop-filter: blur(16px) saturate(1.3); -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 1px 0 rgb(255 255 255 / .12) inset, 0 18px 36px -22px rgb(0 0 0 / .6); transition: background .2s, border-color .2s, transform .12s; }
  .tile:hover { background: rgb(255 255 255 / .18); }
  .tile:active { transform: scale(.98); }
  .tile[aria-pressed="true"] { background: rgb(255 244 230 / .92); color: #2A1A12; border-color: transparent; }
  .ic { position: relative; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: rgb(255 255 255 / .16); flex: none; }
  .tile[aria-pressed="true"] .ic { background: oklch(66% .17 45); color: #fff; }
  .play { width: 15px; height: 15px; margin-left: 2px; }
  .eq { display: none; gap: 2.5px; align-items: end; height: 14px; }
  .eq i { width: 3px; border-radius: 2px; background: currentColor; height: 40%; animation: eq 1.1s ease-in-out infinite; }
  .eq i:nth-child(2) { animation-delay: -.35s; } .eq i:nth-child(3) { animation-delay: -.7s; }
  @keyframes eq { 0%, 100% { height: 30%; } 50% { height: 100%; } }
  .tile[aria-pressed="true"] .play { display: none; }
  .tile[aria-pressed="true"] .eq { display: flex; }
  .txt { display: grid; gap: 4px; min-width: 0; }
  .txt b { font: 600 15.5px/1.2 var(--f-body); }
  .txt small { font: 400 12.5px/1.2 var(--f-body); opacity: .72; }
  @media (prefers-reduced-motion: reduce) { .eq i { animation: none; height: 70%; } }
  @media (max-width: 640px) { .listen { grid-template-columns: 1fr; gap: 8px; } .tile { padding: 12px; } }
</style>
<script>
  import workletUrl from "../../../web/src/scapeWorklet?worker&url";

  const box = document.querySelector<HTMLElement>("[data-listen]");
  if (box) {
    const tiles = [...box.querySelectorAll<HTMLButtonElement>(".tile")];
    let ac: AudioContext | null = null, node: AudioWorkletNode | null = null, gain: GainNode | null = null, on: HTMLButtonElement | null = null, stopTimer = 0;
    const levels = (mix: string) => Object.fromEntries(mix.split(",").map((p) => { const [k, v] = p.split(":"); return [k, +v]; }));

    const start = async (mix: string) => {
      if (!ac) {
        ac = new AudioContext();
        await ac.audioWorklet.addModule(workletUrl);
        gain = ac.createGain(); gain.gain.value = 0; gain.connect(ac.destination);
        node = new AudioWorkletNode(ac, "scape", { numberOfInputs: 0, outputChannelCount: [2], processorOptions: { levels: levels(mix) } });
        node.connect(gain);
      } else node!.port.postMessage({ levels: levels(mix), glide: 1.2 });
      clearTimeout(stopTimer);
      if (ac.state === "suspended") await ac.resume();
      const g = gain!.gain, t = ac.currentTime;
      g.cancelScheduledValues(t); g.setValueAtTime(g.value, t); g.linearRampToValueAtTime(0.4, t + 1.2);
    };
    const stop = () => {
      if (!ac || !gain) return;
      const g = gain.gain, t = ac.currentTime;
      g.cancelScheduledValues(t); g.setValueAtTime(g.value, t); g.linearRampToValueAtTime(0, t + 0.8);
      stopTimer = window.setTimeout(() => ac?.suspend(), 900);
    };
    const mark = (b: HTMLButtonElement | null) => { on = b; tiles.forEach((t) => t.setAttribute("aria-pressed", String(t === b))); };

    tiles.forEach((t) => t.addEventListener("click", () => {
      if (on === t) { mark(null); stop(); return; }
      mark(t); start(t.dataset.mix!).catch(() => mark(null));
    }));
    document.addEventListener("visibilitychange", () => { if (document.hidden && on) { mark(null); stop(); } });
  }
</script>
