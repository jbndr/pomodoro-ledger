---
import { Image } from "astro:assets";
import { emblem, shapeMask } from "../../../web/src/year/emblems";
import type { BadgeId } from "../../../web/src/lib/year";
import coverL from "../assets/shots/year-cover-light.webp";
import coverD from "../assets/shots/year-cover-dark.webp";

const shown: BadgeId = "century";
const hidden: BadgeId[] = ["week", "weekend", "allYear", "early", "month"];
---
<div class="tease" data-tease>
  <div class="cover">
    <Image class="on-light" src={coverL} alt="The cover of Year in Focus: 2026 in focus" width={230} densities={[1, 2]} loading="lazy" />
    <Image class="on-dark" src={coverD} alt="" aria-hidden="true" width={230} densities={[1, 2]} loading="lazy" />
  </div>
  <div class="shelf">
    <p class="k">And badges to find</p>
    <ul>
      <li class="one">
        <span class="medal" style={`--mask:${shapeMask(shown)}`}><Fragment set:html={emblem(shown)} /><i class="foil" /><i class="glare" /></span>
        <b>Century</b>
      </li>
      {hidden.map((id) => (
        <li class="mystery" aria-hidden="true">
          <span class="medal"><Fragment set:html={emblem(id, { locked: true })} /><em>?</em></span>
          <b>&nbsp;</b>
        </li>
      ))}
    </ul>
    <p class="n">One of twelve. The rest you'll have to earn.</p>
  </div>
</div>
<style>
  .tease { display: flex; align-items: center; gap: 36px; }
  .cover { width: 230px; flex: none; }
  .cover :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 2px 3px rgb(20 24 22 / .1)) drop-shadow(0 24px 36px rgb(20 24 22 / .26)); }
  .shelf { width: 250px; padding: 20px 18px 16px; border-radius: 20px; background: color-mix(in oklab, var(--surface) 80%, transparent); backdrop-filter: blur(14px) saturate(1.3); -webkit-backdrop-filter: blur(14px) saturate(1.3); box-shadow: 0 0 0 1px rgb(20 24 22 / .06), 0 22px 44px -24px rgb(20 24 22 / .4); }
  .k { margin: 0 0 14px; font: 600 12px/1 var(--f-body); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); text-align: center; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px 6px; justify-items: center; }
  li { display: grid; justify-items: center; gap: 6px; }
  b { font: 600 12px/1.2 var(--f-body); }
  .medal { position: relative; display: block; width: 58px; aspect-ratio: 1; color: var(--faint); transition: transform .7s cubic-bezier(.22, 1, .36, 1); }
  .medal :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  .one .medal :global(svg) { filter: drop-shadow(0 5px 8px rgb(0 0 0 / .22)); }
  .mystery .medal :global(svg g) { display: none; }
  .mystery em { position: absolute; inset: 0; display: grid; place-items: center; font: 650 20px/1 var(--f-display); font-style: normal; color: var(--faint); }
  .medal.on { transform: perspective(420px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(1.05); transition: transform .12s linear; }
  .foil, .glare { position: absolute; inset: 0; pointer-events: none; -webkit-mask: var(--mask) center / 100% 100% no-repeat; mask: var(--mask) center / 100% 100% no-repeat; }
  .foil {
    background:
      radial-gradient(circle, rgb(255 255 255 / .9) 0 .5px, transparent 1px) 0 0 / 4px 4px,
      repeating-linear-gradient(122deg, #e0303a 0%, #f2a020 3.5%, #c8d81c 7%, #18c87a 10.5%, #1aa6e8 14%, #6a4cf0 17.5%, #d43ab8 21%, #e0303a 24.5%) var(--px, 32%) var(--py, 28%) / 260% 260%;
    mix-blend-mode: color-dodge; opacity: .16; filter: brightness(.62) contrast(1.6) saturate(1.5);
    transition: opacity .4s, background-position .7s cubic-bezier(.22, 1, .36, 1);
  }
  .go .foil { animation: sweep 1.6s cubic-bezier(.22, 1, .36, 1) .3s backwards; }
  .glare { background: radial-gradient(circle at var(--gx, 30%) var(--gy, 18%), rgb(255 255 255 / .55), rgb(255 255 255 / 0) 44%); mix-blend-mode: soft-light; opacity: .6; transition: opacity .4s; }
  .medal.on .foil { opacity: .66; transition: opacity .2s, background-position .12s linear; }
  .medal.on .glare { opacity: 1; }
  @keyframes sweep { from { background-position: 0 0, 110% 110%; opacity: .7; } }
  .n { margin: 14px 0 0; text-align: center; font-size: 12.5px; color: var(--muted); }
  @media (max-width: 640px) {
    .tease { flex-direction: column; gap: 22px; }
    .cover { width: 170px; }
  }
  @media (prefers-reduced-motion: reduce) { .medal, .foil { transition: none; animation: none !important; } }
</style>
<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-tease]")) {
    const el = box.querySelector<HTMLElement>(".one .medal")!;
    const calm = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
    const dim = () => { for (const p of ["--rx", "--ry", "--px", "--py", "--gx", "--gy"]) el.style.removeProperty(p); el.classList.remove("on"); };
    box.addEventListener("pointermove", (e) => {
      if (calm()) return;
      const r = el.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width)), y = Math.max(0, Math.min(1, (e.clientY - r.top) / r.height));
      el.style.setProperty("--rx", ((0.5 - y) * 26).toFixed(2) + "deg");
      el.style.setProperty("--ry", ((x - 0.5) * 26).toFixed(2) + "deg");
      for (const [p, v] of [["--px", x], ["--py", y], ["--gx", x], ["--gy", y]] as const) el.style.setProperty(p, (v * 100).toFixed(1) + "%");
      el.classList.add("on");
    });
    box.addEventListener("pointerleave", dim);
    new IntersectionObserver((es, io) => { if (es.some((e) => e.isIntersecting)) { box.classList.add("go"); io.disconnect(); } }, { threshold: 0.5 }).observe(box);
  }
</script>
