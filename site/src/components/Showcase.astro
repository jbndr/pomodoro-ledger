---
import Paint, { type Kind } from "./Paint.astro";
interface Tab { label: string; cap: string }
interface Props { kind: Kind; tabs?: Tab[]; cap?: string; h?: number; hm?: number; id?: string }
const { kind, tabs = [], cap = "", h = 520, hm = 420, id } = Astro.props;
const n = Math.max(1, tabs.length);
const panes = await Promise.all(Array.from({ length: n }, (_, i) => Astro.slots.render(`p${i}`)));
const caps = tabs.length ? tabs.map((t) => t.cap) : [cap];
const uid = id ?? `sc-${kind}`;
---
<figure class="showcase" data-showcase data-caps={JSON.stringify(caps)} id={uid}>
  <div class="wp panel" style={`--h:${h}px;--hm:${hm}px`}>
    <Paint kind={kind} />
    {tabs.length > 1 && (
      <div class="tabs" role="tablist" aria-label="Views">
        {tabs.map((t, i) => (
          <button type="button" role="tab" id={`${uid}-t${i}`} aria-controls={`${uid}-p${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
        ))}
      </div>
    )}
    <div class="stage">
      {panes.map((html, i) => (
        <div class="pane" id={`${uid}-p${i}`} role={tabs.length > 1 ? "tabpanel" : undefined} aria-labelledby={tabs.length > 1 ? `${uid}-t${i}` : undefined} data-on={i === 0 ? "" : undefined} inert={i === 0 ? undefined : true} set:html={html} />
      ))}
    </div>
  </div>
  {caps[0] && <figcaption class="cap" aria-live="polite">{caps[0]}</figcaption>}
</figure>
<style>
  .showcase { margin: 36px 0 0; }
  .panel { display: flex; flex-direction: column; }
  .tabs { position: relative; z-index: 2; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; background: rgb(255 255 255 / .34); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); border-bottom: 1px solid rgb(255 255 255 / .35); }
  .tabs button { appearance: none; border: 0; background: transparent; padding: 15px 10px; font: 600 14.5px/1.2 var(--f-body); color: rgb(20 24 22 / .62); cursor: pointer; transition: color .2s, background .2s; position: relative; }
  .tabs button + button { box-shadow: inset 1px 0 rgb(255 255 255 / .35); }
  .tabs button:hover { color: rgb(20 24 22 / .9); }
  .tabs button[aria-selected="true"] { color: #141816; background: rgb(255 255 255 / .5); }
  .stage { position: relative; height: var(--h); }
  .pane { position: absolute; inset: 0; display: grid; place-items: center; padding: 40px 32px; opacity: 0; transform: translateY(8px) scale(.99); transition: opacity .32s ease, transform .42s cubic-bezier(.2, .8, .2, 1); pointer-events: none; }
  .pane[data-on] { opacity: 1; transform: none; pointer-events: auto; }
  .cap { text-align: center; font-size: 13px; color: var(--faint); margin: 14px auto 0; max-width: 34rem; min-height: 1.6em; text-wrap: balance; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .tabs { background: rgb(14 17 16 / .42); border-bottom-color: rgb(255 255 255 / .08); }
    :global(:root:not([data-theme="light"])) .tabs button { color: rgb(232 236 233 / .6); }
    :global(:root:not([data-theme="light"])) .tabs button + button { box-shadow: inset 1px 0 rgb(255 255 255 / .07); }
    :global(:root:not([data-theme="light"])) .tabs button[aria-selected="true"] { color: #E8ECE9; background: rgb(255 255 255 / .08); }
  }
  :global(:root[data-theme="dark"]) .tabs { background: rgb(14 17 16 / .42); border-bottom-color: rgb(255 255 255 / .08); }
  :global(:root[data-theme="dark"]) .tabs button { color: rgb(232 236 233 / .6); }
  :global(:root[data-theme="dark"]) .tabs button[aria-selected="true"] { color: #E8ECE9; background: rgb(255 255 255 / .08); }
  @media (max-width: 640px) {
    .stage { height: var(--hm); }
    .pane { padding: 24px 16px; }
    .tabs button { padding: 13px 4px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .pane { transition: opacity .2s; transform: none; } }
</style>
<script>
  for (const sc of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
    const tabs = [...sc.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const panes = [...sc.querySelectorAll<HTMLElement>(".pane")];
    const cap = sc.querySelector("figcaption");
    const caps: string[] = JSON.parse(sc.dataset.caps || "[]");
    const pick = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute("aria-selected", String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panes.forEach((p, j) => { p.toggleAttribute("data-on", i === j); p.inert = i !== j; });
      if (cap && caps[i]) cap.textContent = caps[i];
      if (focus) tabs[i].focus();
      sc.dispatchEvent(new CustomEvent("pane", { detail: i }));
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => pick(i));
      t.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (d) { e.preventDefault(); pick((i + d + tabs.length) % tabs.length, true); }
      });
    });
  }
</script>
