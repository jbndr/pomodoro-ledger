---
const ticks = Array.from({ length: 60 }, (_, i) => i);
---
<svg class="dial" viewBox="0 0 200 200" role="img" aria-label="A focus round, two thirds done">
  <circle cx="100" cy="100" r="92" fill="var(--surface)" stroke="var(--line)" />
  {ticks.map((i) => (
    <line x1="100" y1="16" x2="100" y2={i % 5 ? 21 : 25} transform={`rotate(${i * 6} 100 100)`}
      stroke={i < 40 ? "var(--tomato)" : "var(--line-2)"} stroke-width={i % 5 ? 1.2 : 2} stroke-linecap="round" />
  ))}
  <text x="100" y="108" text-anchor="middle" font-family="var(--f-display)" font-size="40" font-weight="600" fill="var(--fg)" style="font-variant-numeric: tabular-nums">08:20</text>
  <text x="100" y="132" text-anchor="middle" font-family="var(--f-body)" font-size="11" fill="var(--muted)" letter-spacing="1.5">FOCUS · 3 OF 4</text>
</svg>
<style>
  .dial { width: 100%; height: auto; filter: drop-shadow(0 24px 40px rgb(20 24 22 / .14)); }
</style>
