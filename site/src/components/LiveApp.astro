---
import { getImage } from "astro:assets";
import Paint from "./Paint.astro";
import deskL from "../assets/shots/app-light.webp";
import deskD from "../assets/shots/app-dark.webp";
import phoneL from "../assets/shots/phone-light.webp";
import phoneD from "../assets/shots/phone-dark.webp";
const host = new URL(Astro.site!).host;
const alt = "Pomodoro Ledger: a 25-minute focus timer next to today's tasks";
const [dl, dd, pl, pd] = await Promise.all([
  getImage({ src: deskL, width: 1280, densities: [1, 2] }),
  getImage({ src: deskD, width: 1280, densities: [1, 2] }),
  getImage({ src: phoneL, width: 390, densities: [1, 2] }),
  getImage({ src: phoneD, width: 390, densities: [1, 2] }),
]);
---
<div class="live wp" data-live>
  <Paint kind="dawn" />
  <div class="win">
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>{host}/app</span></div>
    <div class="frame" data-frame>
      <div class="poster">
        <picture class="on-light"><source media="(max-width: 700px)" srcset={pl.srcSet.attribute} /><img src={dl.src} srcset={dl.srcSet.attribute} width="1280" height="800" alt={alt} loading="lazy" /></picture>
        <picture class="on-dark"><source media="(max-width: 700px)" srcset={pd.srcSet.attribute} /><img src={dd.src} srcset={dd.srcSet.attribute} width="1280" height="800" alt="" aria-hidden="true" loading="lazy" /></picture>
        <script is:inline>for (const p of document.currentScript.parentElement.querySelectorAll("picture")) if (getComputedStyle(p).display !== "none") { const i = p.querySelector("img"); i.loading = "eager"; i.fetchPriority = "high"; }</script>
      </div>
    </div>
    <button class="try" type="button" data-try data-hit="try-here:live">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor" /></svg>
      Try it right here
    </button>
    <span class="badge" aria-hidden="true">Live demo · nothing is saved</span>
  </div>
  <a class="try phone-only" href="/app/?demo=1" data-hit="try-demo:live">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z" fill="currentColor" /></svg>
    Try the demo
  </a>
</div>
<style>
  .live { position: relative; padding: 56px 56px 0; border-radius: 26px; }
  .live .win { border-radius: 14px 14px 0 0; }
  .win { position: relative; border-radius: 14px; overflow: hidden; background: var(--surface); box-shadow: 0 0 0 1px rgb(20 24 22 / .08), 0 2px 4px rgb(20 24 22 / .06), 0 40px 80px -30px rgb(20 24 22 / .45); }
  .chrome { display: flex; align-items: center; gap: 7px; height: 38px; padding: 0 14px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
  .chrome i { width: 11px; height: 11px; border-radius: 50%; background: var(--line-2); }
  .chrome span { margin: 0 auto; transform: translateX(-22px); font: 500 12px/1 var(--f-body); color: var(--faint); background: var(--surface); border: 1px solid var(--line); padding: 6px 14px; border-radius: 7px; min-width: 40%; text-align: center; }
  .frame { position: relative; aspect-ratio: 1280 / 800; overflow: hidden; background: #EDEFEC; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .frame { background: #0E1110; } }
  :global(:root[data-theme="dark"]) .frame { background: #0E1110; }
  .live { perspective: 1800px; }
  @media (prefers-reduced-motion: no-preference) and (min-width: 701px) {
    @supports (animation-timeline: view()) {
      .win { transform-origin: 50% 0; animation: settle linear both; animation-timeline: view(); animation-range: entry 0% cover 42%; }
      @keyframes settle { from { transform: rotateX(14deg) translateY(28px) scale(.96); } to { transform: none; } }
    }
  }
  .poster { position: absolute; inset: 0; transition: opacity .5s ease; }
  .poster picture { position: absolute; inset: 0; }
  .poster img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .frame :global(iframe) { position: absolute; top: 0; left: 0; width: 1280px; height: 800px; border: 0; transform-origin: 0 0; transform: scale(var(--s, 1)); opacity: 0; transition: opacity .5s ease; }
  .live.on .frame :global(iframe) { opacity: 1; }
  .live.on .poster { opacity: 0; pointer-events: none; }
  .try { position: absolute; left: 50%; bottom: 22px; translate: -50% 0; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px 0 16px; border-radius: 999px; border: 1px solid rgb(255 255 255 / .5);
    background: rgb(20 24 22 / .82); color: #fff; font: 600 15px/1 var(--f-body); cursor: pointer; text-decoration: none; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / .5); transition: transform .15s, background .2s, opacity .3s; }
  .try:hover { background: rgb(20 24 22 / .92); }
  .try:active { transform: scale(.97); }
  .try svg { width: 15px; height: 15px; color: var(--tomato); }
  .try.loading { opacity: .7; pointer-events: none; }
  .live.on .try { opacity: 0; pointer-events: none; }
  .phone-only { display: none; }
  .badge { position: absolute; right: 12px; top: 9px; font: 500 11.5px/1 var(--f-body); color: var(--leaf); background: color-mix(in oklab, var(--leaf) 12%, var(--surface)); padding: 5px 9px; border-radius: 999px; opacity: 0; transition: opacity .4s; }
  .live.on .badge { opacity: 1; }

  @media (max-width: 700px) {
    .live { padding: 36px 20px; }
    .live .win { border-radius: 40px; }
    .win { max-width: 300px; margin: 0 auto; border-radius: 40px; padding: 10px; background: #141816; box-shadow: 0 0 0 1px rgb(255 255 255 / .06) inset, 0 30px 60px -24px rgb(20 24 22 / .55); }
    .chrome, .badge { display: none; }
    .frame { aspect-ratio: 390 / 844; border-radius: 31px; }
    .try:not(.phone-only) { display: none; }
    .phone-only { display: flex; position: relative; left: auto; bottom: auto; translate: none; width: max-content; margin: 20px auto 0; white-space: nowrap; }
    .live { padding-bottom: 24px; }
  }
</style>
<script>
  const live = document.querySelector<HTMLElement>("[data-live]");
  const frame = live?.querySelector<HTMLElement>("[data-frame]");
  const btn = live?.querySelector<HTMLButtonElement>("[data-try]");
  if (live && frame && btn) {
    const fit = () => frame.style.setProperty("--s", String(frame.clientWidth / 1280));
    new ResizeObserver(fit).observe(frame);
    btn.addEventListener("click", () => {
      btn.classList.add("loading");
      const f = document.createElement("iframe");
      f.src = "/app/?demo=1&embed=1";
      f.title = "Pomodoro Ledger, live demo";
      f.addEventListener("load", () => { live.classList.add("on"); f.focus(); }, { once: true });
      frame.append(f);
    });
  }
</script>
